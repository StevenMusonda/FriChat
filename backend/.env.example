# Environment Configuration for FriChat Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Choose MySQL or PostgreSQL)
# For MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=frichat

# For PostgreSQL (uncomment if using):
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=frichat

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# JWT_EXPIRES_IN is no longer used (phase 6): see ACCESS_TOKEN_TTL below

# Sessions (phase 6)
# Short-lived access JWT (kept in page memory) + rotating refresh token in an HttpOnly cookie
ACCESS_TOKEN_TTL=15m
# Refresh token / session lifetime in days; slides forward on every refresh
REFRESH_TOKEN_TTL_DAYS=30
# A just-rotated refresh token presented again within this many seconds is a two-tab race (retry),
# after that it counts as stolen and the whole session is revoked
REFRESH_REUSE_GRACE_SECONDS=10
# strict (default) | lax | none - use none only when frontend and API are on different sites (forces Secure)
COOKIE_SAMESITE=strict
# Secure cookie flag (default true); set false only for plain-http testing in browsers that refuse it on localhost
COOKIE_SECURE=true
# Behind a reverse proxy (Render, nginx): number of proxies, so rate limits and Settings > Devices see client IPs
# TRUST_PROXY=1

# Email verification links (phase 6)
EMAIL_VERIFICATION_TTL_HOURS=24

# File Upload Configuration
MAX_FILE_SIZE=104857600
# Max file size in bytes (100MB = 104857600)
UPLOAD_PATH=./uploads

# Allowed file types (comma-separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/zip,application/x-zip-compressed

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Socket.IO Configuration
SOCKET_IO_PATH=/socket.io

# Password Reset / Email
# Public URL of the frontend folder - reset links point to <FRONTEND_URL>/reset-password.html,
# verification links to <FRONTEND_URL>/verify-email.html
# (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:8080
# SMTP settings - if SMTP_HOST is empty, reset and verification links are printed to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FriChat <no-reply@frichat.local>"

# Web Push notifications
# Generate once with `npm run vapid:generate` and keep them - new keys invalidate every subscription.
# Leave the keys empty to switch push off (everything else keeps working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: address or https URL
VAPID_SUBJECT=mailto:admin@example.com

# Link previews
# The server fetches Open Graph data for the first link in a message (public http/https only;
# private, loopback and link-local addresses are always refused). Set to false to switch previews off.
LINK_PREVIEWS_ENABLED=true

# Groups (phase 5)
# Invite links (/join.html?code=...). Set to false to switch creating, previewing and joining by link off;
# admins can still revoke existing links and handle pending join requests.
ENABLE_INVITE_LINKS=true
# Largest group avatar upload in bytes (default 2 MB). JPEG, PNG or WebP only; resized to 256x256 WebP when sharp is installed.
GROUP_AVATAR_MAX_BYTES=2097152

# Profile photos (phase 9): largest upload in bytes (default 5 MB). JPEG, PNG or WebP only; always
# re-encoded by sharp as a 512x512 WebP (uploads are refused when sharp is not installed).
PROFILE_AVATAR_MAX_BYTES=5242880

# Scheduler (phase 8): how often scheduled messages, reminders and timed poll closing are checked,
# in seconds (5-300, default 15). A scheduled message goes out at most this long after its time.
SCHEDULER_TICK_SECONDS=15
