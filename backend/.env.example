# Environment Configuration for FriChat Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Choose MySQL or PostgreSQL)
# For MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=frichat

# For PostgreSQL (uncomment if using):
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=frichat

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# JWT_EXPIRES_IN is no longer used (phase 6): see ACCESS_TOKEN_TTL below

# Sessions (phase 6)
# Short-lived access JWT (kept in page memory) + rotating refresh token in an HttpOnly cookie
ACCESS_TOKEN_TTL=15m
# Refresh token / session lifetime in days; slides forward on every refresh
REFRESH_TOKEN_TTL_DAYS=30
# A just-rotated refresh token presented again within this many seconds is a two-tab race (retry),
# after that it counts as stolen and the whole session is revoked
REFRESH_REUSE_GRACE_SECONDS=10
# strict (default) | lax | none - use none only when frontend and API are on different sites (forces Secure)
COOKIE_SAMESITE=strict
# Secure cookie flag (default true); set false only for plain-http testing in browsers that refuse it on localhost
COOKIE_SECURE=true
# Behind a reverse proxy (Render, nginx): number of proxies, so rate limits and Settings > Devices see client IPs
# TRUST_PROXY=1

# Email verification links (phase 6)
EMAIL_VERIFICATION_TTL_HOURS=24

# File Upload Configuration
MAX_FILE_SIZE=104857600
# Max file size in bytes (100MB = 104857600)
UPLOAD_PATH=./uploads

# Allowed file types (comma-separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/zip,application/x-zip-compressed

# Voice notes and other audio (phase 10): allowed types (codec parameters such as ";codecs=opus" are
# ignored) and their own size cap in bytes (default 10 MB, never above MAX_FILE_SIZE). A 5-minute
# voice note is about 1-2 MB (webm/opus) or up to ~5 MB (Safari's mp4/AAC).
ALLOWED_AUDIO_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/aac
MAX_AUDIO_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Socket.IO Configuration
SOCKET_IO_PATH=/socket.io

# Password Reset / Email
# Public URL of the frontend folder - reset links point to <FRONTEND_URL>/reset-password.html,
# verification links to <FRONTEND_URL>/verify-email.html
# (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:8080
# SMTP settings - if SMTP_HOST is empty, reset and verification links are printed to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FriChat <no-reply@frichat.local>"

# Web Push notifications
# Generate once with `npm run vapid:generate` and keep them - new keys invalidate every subscription.
# Leave the keys empty to switch push off (everything else keeps working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: address or https URL
VAPID_SUBJECT=mailto:admin@example.com

# Link previews
# The server fetches Open Graph data for the first link in a message (public http/https only;
# private, loopback and link-local addresses are always refused). Set to false to switch previews off.
LINK_PREVIEWS_ENABLED=true

# Groups (phase 5)
# Invite links (/join.html?code=...). Set to false to switch creating, previewing and joining by link off;
# admins can still revoke existing links and handle pending join requests.
ENABLE_INVITE_LINKS=true
# Largest group avatar upload in bytes (default 2 MB). JPEG, PNG or WebP only; resized to 256x256 WebP when sharp is installed.
GROUP_AVATAR_MAX_BYTES=2097152

# Profile photos (phase 9): largest upload in bytes (default 5 MB). JPEG, PNG or WebP only; always
# re-encoded by sharp as a 512x512 WebP (uploads are refused when sharp is not installed).
PROFILE_AVATAR_MAX_BYTES=5242880

# Scheduler (phase 8): how often scheduled messages, reminders, timed poll closing and (phase 10)
# expired disappearing messages are checked, in seconds (5-300, default 15). A scheduled message goes
# out, and an expired message is deleted, at most this long after its time.
SCHEDULER_TICK_SECONDS=15

# Calls (phase 11): ICE servers for WebRTC. STUN defaults to Google's public servers.
# Calls need HTTPS (localhost excepted). See FEATURES_SETUP.md, Phase 11, for running coturn.
#STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (needed behind strict NAT / mobile networks). Comma-separated turn:/turns: URLs.
#TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# coturn static-auth-secret: short-lived credentials are generated per user (REST-API scheme)
#TURN_SECRET=
# Lifetime of those credentials in seconds (600-86400, default 21600)
#TURN_TTL=21600
# Or fixed credentials from a hosted TURN service (used only when TURN_SECRET is empty)
#TURN_USERNAME=
#TURN_PASSWORD=

# Uploads and moderation (phase 13)
# Each message upload's real type comes from its bytes; images are re-encoded by sharp (without
# sharp, photos are refused). ALLOWED_*_TYPES can't add types with no signature (text, HTML, SVG).
# Private folders, never served; both must be outside UPLOAD_PATH (default ./private/...)
#QUARANTINE_PATH=./private/quarantine
#REPORT_EVIDENCE_PATH=./private/report-evidence
# Attachments of reported messages are copied as evidence up to this size in bytes (default 25 MB)
#REPORT_EVIDENCE_MAX_BYTES=26214400

# Optional ClamAV scan through clamd. Leave off when ClamAV isn't installed.
CLAMAV_ENABLED=false
#CLAMAV_HOST=127.0.0.1
#CLAMAV_PORT=3310
# Unix socket instead of host and port
#CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
#CLAMAV_TIMEOUT_MS=30000
# With the scanner unreachable, uploads are refused; true lets them through unscanned
CLAMAV_FAIL_OPEN=false

# Spam limits: accounts younger than SPAM_NEW_ACCOUNT_HOURS may send this many messages an hour to
# people who haven't accepted their message request. 0 in either switches the limit off.
SPAM_NEW_ACCOUNT_HOURS=72
SPAM_NON_CONTACT_MESSAGES_PER_HOUR=20

# Two-factor authentication (phase 14)
# Encrypts every 2FA secret. Generate once and back it up apart from the database:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, 2FA can't be set up. If it's lost or changed, authenticator codes stop working
# (recovery codes still do). See FEATURES_SETUP.md, Phase 14.
TOTP_ENCRYPTION_KEY=
# Name shown in authenticator apps
#TOTP_ISSUER=FriChat
# Wrong codes in a row before a lock (3-20), and how long the lock lasts
#TWO_FACTOR_MAX_ATTEMPTS=5
#TWO_FACTOR_LOCK_MINUTES=15

# Data export and account deletion (phase 14)
# Private folder for export zips, outside UPLOAD_PATH (default ./private/exports)
#DATA_EXPORT_PATH=./private/exports
# How long an export can be downloaded, and the time between exports (0 = no limit)
#DATA_EXPORT_TTL_HOURS=72
#DATA_EXPORT_COOLDOWN_HOURS=24
# Grace period before a deleted account is purged. The texts in the app say 14, so change them too.
#ACCOUNT_DELETION_GRACE_DAYS=14
