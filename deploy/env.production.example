# Production settings for https://frichat.online on the Hetzner server.
# Copy to /var/www/frichat/backend/.env and fill in the CHANGE_ME values.
# Every other setting in backend/.env.example keeps its default; copy more lines from there only if you need them.
# NEVER commit the real .env file (it is in .gitignore).

PORT=3000
NODE_ENV=production

# --- Database (PostgreSQL on the same server, localhost only) ---
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=frichat
DB_PASSWORD=CHANGE_ME
DB_NAME=frichat

# --- Secrets: generate each one on the server, they must all be different ---
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# Encrypts 2FA secrets. Back it up apart from the database; if it is lost, authenticator codes stop working.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=CHANGE_ME

# --- Public address (one domain serves the pages, the API and Socket.IO) ---
CORS_ORIGIN=https://frichat.online
FRONTEND_URL=https://frichat.online
PUBLIC_API_URL=https://frichat.online

# --- Behind Caddy/nginx: 1 proxy in front of Node, so rate limits and Settings > Devices see real client IPs ---
# (Put Cloudflare in front as well and this becomes 2.)
TRUST_PROXY=1

# --- Cookies (same site, HTTPS) ---
COOKIE_SAMESITE=strict
COOKIE_SECURE=true

# --- Email: verification and password-reset links. Without SMTP they are only printed in the server log,
# so real users could not verify or reset. Hetzner blocks outgoing port 25 (and often 465): use 587 with a provider
# (Brevo, Mailgun, Resend, Gmail app password...) and add the SPF/DKIM records they give you for frichat.online.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="FriChat <no-reply@frichat.online>"

# --- Web Push: run `npm run vapid:generate` in backend/ once, paste the keys, never regenerate them ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@frichat.online

# --- Uploads (stored on the server's disk under backend/uploads) ---
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

# --- Optional: leave empty / off until you want them ---
ANTHROPIC_API_KEY=
CLAMAV_ENABLED=false
# Calls work with the default public STUN server; add TURN (coturn) for calls on strict mobile networks.
# See FEATURES_SETUP.md, Phase 11.
#TURN_URL=turn:frichat.online:3478?transport=udp,turn:frichat.online:3478?transport=tcp
#TURN_SECRET=CHANGE_ME
